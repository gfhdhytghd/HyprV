#!/usr/bin/env lua
local delta = arg[1]=="--inc" and 1 or arg[1]=="--dec" and -1
if delta then
  local expr='require("hypr.controls").keyboard_step(' .. delta .. ')'
  local ok=os.execute("hyprctl eval '" .. expr .. "'")
  if not ok then os.exit(1) end
else
  local p=assert(io.popen("brightnessctl -d '*::kbd_backlight' get"));io.write(p:read("*a"));if not p:close() then os.exit(1) end
end
