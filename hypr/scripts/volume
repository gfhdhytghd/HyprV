#!/usr/bin/env lua
-- Compatibility CLI for native Hyprland Lua audio controls.
local action=(arg[1] or '--get'):gsub('^%-%-','')
local function quote(s)return "'" .. s:gsub("'","'\\''") .. "'" end
local function capture(cmd)
 local p=assert(io.popen(cmd));local s=p:read('*a');local ok=p:close();if not ok then os.exit(1) end;return s
end
if action=='get' then io.write(capture('pamixer --get-volume'));return end
if action=='get-icon' or action=='get-mic-icon' then
 local mic=action=='get-mic-icon';local prefix=mic and 'pamixer --default-source ' or 'pamixer '
 local muted=capture(prefix .. '--get-mute'):match('true')
 local volume=tonumber(capture(prefix .. '--get-volume')) or 0
 local icon=mic and (muted and 'microphone-mute' or 'microphone') or ((muted or volume==0) and 'volume-mute' or volume<=30 and 'volume-low' or volume<=60 and 'volume-mid' or 'volume-high')
 print(os.getenv('HOME') .. '/.config/HyprV/mako/icons/' .. icon .. '.png');return
end
local allowed={inc=true,dec=true,toggle=true,['toggle-mic']=true,['mic-inc']=true,['mic-dec']=true,set=true}
assert(allowed[action],'Unknown volume command')
local expr='require("hypr.controls").volume(' .. string.format('%q',action)
if action=='set' then expr=expr .. ',' .. assert(tonumber(arg[2])) end
expr=expr .. ')'
capture('hyprctl ' .. (os.getenv('HYPRLAND_INSTANCE_SIGNATURE') and '' or '-i 0 ') .. 'eval ' .. quote(expr))
