#!/usr/bin/env bash

###########################################################
#   脚本功能：在亮度范围 1～400 上，以指数曲线生成严格单调的
#           50 级亮度表；每次调用脚本自动加/减一级。
#   说明：
#     - MIN、MAX 分别表示物理最小/最大亮度值（此处固定为 1、400）。
#     - STEP 范围 [0,50]，每次 inc/dec 对应 step +/-1。
#     - UI 仍然显示 [0,100]，每个 step 对应固定 2%。
#     - 启动时会预生成 51 个 step -> raw 的唯一映射值。
#     - 反查时返回最接近当前 raw 值的 step，保证 UI 与脚本步进一致。
#     - 图标按 level 分段（0-20、21-40、41-60、61-80、81-100）选取。
###########################################################

## 1. 常量定义 ##
iDIR="$HOME/.config/HyprV/mako/icons"   # 图标目录
MIN=1
MAX=400
STEP_MAX=50
UI_MAX=100
QS_CONFIG_DIR="$HOME/.config/HyprV/quickshell"
declare -a STEP_VALUES=()

BACKEND=""
BACKLIGHT_DEVICE=""
DDC_BUS=""
DDC_MAX=""
DDC_CACHE_FILE="${XDG_RUNTIME_DIR:-/tmp}/hyprv-brightness-ddc-${UID}.cache"

detect_backend() {
    local path bus values cached_bus cached_max

    for path in /sys/class/backlight/*; do
        [[ -e "$path" ]] || continue
        BACKEND="backlight"
        BACKLIGHT_DEVICE="${path##*/}"
        MAX=$(brightnessctl --device "$BACKLIGHT_DEVICE" max)
        return 0
    done

    if command -v ddcutil >/dev/null 2>&1; then
        if read -r cached_bus cached_max < "$DDC_CACHE_FILE" 2>/dev/null \
            && [[ "$cached_bus" =~ ^[0-9]+$ && "$cached_max" =~ ^[1-9][0-9]*$ ]] \
            && [[ -e "/dev/i2c-$cached_bus" ]]; then
            BACKEND="ddc"
            DDC_BUS="$cached_bus"
            DDC_MAX="$cached_max"
            return 0
        fi

        while read -r bus; do
            [[ -n "$bus" ]] || continue
            values=$(ddcutil --bus "$bus" getvcp 10 --terse 2>/dev/null) || continue
            if [[ "$values" =~ ^VCP[[:space:]]+10[[:space:]]+C[[:space:]]+[0-9]+[[:space:]]+[0-9]+ ]]; then
                BACKEND="ddc"
                DDC_BUS="$bus"
                DDC_MAX=$(awk '$1 == "VCP" && $2 == "10" && $3 == "C" { print $5; exit }' <<< "$values")
                printf '%s %s\n' "$DDC_BUS" "$DDC_MAX" > "$DDC_CACHE_FILE"
                return 0
            fi
        done < <(ddcutil detect --brief 2>/dev/null | awk '/I2C bus:/ { sub("/dev/i2c-", "", $3); print $3 }')
    fi

    echo "No controllable backlight or DDC/CI display found" >&2
    return 1
}

ddc_values() {
    ddcutil --bus "$DDC_BUS" getvcp 10 --terse 2>/dev/null \
        | awk '$1 == "VCP" && $2 == "10" && $3 == "C" { print $4, $5; exit }'
}

detect_backend || exit 1

# 启动时预先计算 log(MAX)
#   使用 bc -l 计算自然对数：
MAX_LOG=$(echo "l($MAX)" | bc -l)

###########################################################
#   init_step_table():
#     生成严格递增的 step -> raw 表，保证 50 级步进一一对应。
###########################################################
init_step_table() {
    local step prev raw target rounded min_allowed max_allowed

    prev=$(( MIN - 1 ))
    for (( step = 0; step <= STEP_MAX; step++ )); do
        if (( step == 0 )); then
            raw=$MIN
        elif (( step == STEP_MAX )); then
            raw=$MAX
        else
            target=$(echo "scale=10; e($MAX_LOG * $step / $STEP_MAX)" | bc -l)
            rounded=$(printf "%.0f" "$target")
            min_allowed=$(( prev + 1 ))
            max_allowed=$(( MAX - (STEP_MAX - step) ))

            if (( rounded < min_allowed )); then
                raw=$min_allowed
            elif (( rounded > max_allowed )); then
                raw=$max_allowed
            else
                raw=$rounded
            fi
        fi

        STEP_VALUES[$step]=$raw
        prev=$raw
    done
}

###########################################################
#   get_current():
#     返回当前亮度（raw value），即 brightnessctl g 的输出。
###########################################################
get_current() {
    if [[ "$BACKEND" == "backlight" ]]; then
        brightnessctl --device "$BACKLIGHT_DEVICE" get
        return
    fi

    ddc_values | awk '{ print $1 }'
}

init_step_table

###########################################################
#   step_from_value(cur):
#     输入 cur（1～400），返回最接近当前 raw 的逻辑 step。
###########################################################
step_from_value() {
    local cur="$1"
    local step raw prev_raw

    if (( cur <= MIN )); then
        echo 0
        return
    elif (( cur >= MAX )); then
        echo "$STEP_MAX"
        return
    fi

    for (( step = 0; step <= STEP_MAX; step++ )); do
        raw=${STEP_VALUES[$step]}
        if (( raw >= cur )); then
            if (( step == 0 )); then
                echo 0
            else
                prev_raw=${STEP_VALUES[$(( step - 1 ))]}
                if (( cur - prev_raw <= raw - cur )); then
                    echo $(( step - 1 ))
                else
                    echo "$step"
                fi
            fi
            return
        fi
    done

    echo "$STEP_MAX"
}

###########################################################
#   value_from_step(step):
#     输入 step（0～50），输出对应的物理亮度值（1～400）。
###########################################################
value_from_step() {
    local step="$1"

    if (( step <= 0 )); then
        echo "$MIN"
        return
    elif (( step >= STEP_MAX )); then
        echo "$MAX"
        return
    fi

    echo "${STEP_VALUES[$step]}"
}

###########################################################
#   ui_level_from_step(step):
#     将 50 级 step 转成 UI 百分比。每个 step 固定 2%。
###########################################################
ui_level_from_step() {
    local step="$1"

    if (( step <= 0 )); then
        echo 0
        return
    elif (( step >= STEP_MAX )); then
        echo "$UI_MAX"
        return
    fi

    echo $(( step * UI_MAX / STEP_MAX ))
}

###########################################################
#   step_from_ui_level(level):
#     将 UI 百分比转换成最接近的 step。
###########################################################
step_from_ui_level() {
    local level="$1"

    if (( level <= 0 )); then
        echo 0
        return
    elif (( level >= UI_MAX )); then
        echo "$STEP_MAX"
        return
    fi

    echo $(( (level * STEP_MAX + UI_MAX / 2) / UI_MAX ))
}

###########################################################
#   get_icon(level):
#     根据 level（0～100）选择对应的图标，共 5 段：
#       [  0～20 ] → brightness-20.png
#       [21～40 ] → brightness-40.png
#       [41～60 ] → brightness-60.png
#       [61～80 ] → brightness-80.png
#       [81～100] → brightness-100.png
###########################################################
get_icon() {
    local level="$1"
    local icon_file=""

    if (( level <= 20 )); then
        icon_file="brightness-20.png"
    elif (( level <= 40 )); then
        icon_file="brightness-40.png"
    elif (( level <= 60 )); then
        icon_file="brightness-60.png"
    elif (( level <= 80 )); then
        icon_file="brightness-80.png"
    else
        icon_file="brightness-100.png"
    fi

    echo "$iDIR/$icon_file"
}

###########################################################
#   notify_user(action, level):
#     通知 quickshell 更新亮度快捷弹窗。
###########################################################
notify_user() {
    local action="${1:-showBrightness}"
    local level="${2:-}"

    if [[ -n "$level" ]]; then
        quickshell -p "$QS_CONFIG_DIR" ipc call quickAdjust "$action" "$level" >/dev/null 2>&1 || true
        quickshell -p "$QS_CONFIG_DIR" ipc call quickAdjust showBrightness >/dev/null 2>&1 || true
        return
    fi

    quickshell -p "$QS_CONFIG_DIR" ipc call quickAdjust "$action" >/dev/null 2>&1 || \
        quickshell -p "$QS_CONFIG_DIR" ipc call quickAdjust showBrightness >/dev/null 2>&1 || true
}

###########################################################
#   inc_brightness():
#     将当前亮度对应的 level + 1，然后写回实际值并通知。
###########################################################
inc_brightness() {
    local ui_level
    ui_level=$(( $(get_level) + 2 ))
    (( ui_level > UI_MAX )) && ui_level=$UI_MAX
    set_level "$ui_level"
    notify_user showBrightnessLevel "$ui_level"
}


###########################################################
#   dec_brightness():
#     将当前亮度对应的 level - 1，然后写回实际值并通知。
###########################################################
dec_brightness() {
    local ui_level
    ui_level=$(( $(get_level) - 2 ))
    (( ui_level < 0 )) && ui_level=0
    set_level "$ui_level"
    notify_user showBrightnessLevel "$ui_level"
}

###########################################################
#   get_direct():
#     直接读取并打印当前亮度（raw value）。
###########################################################
get_direct() {
    get_current
}

###########################################################
#   get_level():
#     返回当前亮度对应的 UI 百分比（0～100）。
###########################################################
get_level() {
    local cur_val max_val step

    if [[ "$BACKEND" == "ddc" ]]; then
        read -r cur_val max_val < <(ddc_values)
        [[ "$cur_val" =~ ^[0-9]+$ && "$max_val" =~ ^[1-9][0-9]*$ ]] || return 1
        echo $(( (cur_val * UI_MAX + max_val / 2) / max_val ))
        return
    fi

    cur_val=$(get_current)
    step=$(step_from_value "$cur_val")
    ui_level_from_step "$step"
}

###########################################################
#   get_ui_level():
#     UI 与脚本步进保持一致，这里直接复用 UI 百分比。
###########################################################
get_ui_level() {
    get_level
}

###########################################################
#   set_level(level):
#     按 UI 百分比（0～100）设置亮度，不触发通知。
###########################################################
set_level() {
    local level="${1:-}"
    local step new_val cur_val max_val

    if [[ -z "$level" || ! "$level" =~ ^-?[0-9]+$ ]]; then
        echo "Invalid level: $level" >&2
        exit 1
    fi

    if (( level < 0 )); then
        level=0
    elif (( level > UI_MAX )); then
        level=$UI_MAX
    fi

    if [[ "$BACKEND" == "ddc" ]]; then
        max_val="$DDC_MAX"
        [[ "$max_val" =~ ^[1-9][0-9]*$ ]] || return 1
        new_val=$(( (level * max_val + UI_MAX / 2) / UI_MAX ))
        if ! ddcutil --bus "$DDC_BUS" setvcp 10 "$new_val"; then
            rm -f "$DDC_CACHE_FILE"
            return 1
        fi
        return
    fi

    step=$(step_from_ui_level "$level")
    new_val=$(value_from_step "$step")
    brightnessctl --device "$BACKLIGHT_DEVICE" set "${new_val}raw"
}

###########################################################
#   set_ui_level(level):
#     UI 与脚本步进保持一致，这里直接复用 UI 百分比。
###########################################################
set_ui_level() {
    set_level "${1:-}"
}

###########################################################
#   脚本入口
#     接受参数：
#       --get / --get-level / --set-level <n>
#       --get-ui-level / --set-ui-level <n>
#       --inc / --dec
###########################################################
case "$1" in
    --get)
        get_direct
        ;;
    --get-level)
        get_level
        ;;
    --set-level)
        set_level "${2:-}"
        ;;
    --get-ui-level)
        get_ui_level
        ;;
    --set-ui-level)
        set_ui_level "${2:-}"
        ;;
    --inc)
        inc_brightness
        ;;
    --dec)
        dec_brightness
        ;;
    *)
        echo "Usage: $0 [--get | --get-level | --set-level <n> | --get-ui-level | --set-ui-level <n> | --inc | --dec]"
        exit 1
        ;;
esac

#exit 0
