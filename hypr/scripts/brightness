#!/usr/bin/env lua
-- Compatibility CLI: all brightness logic lives inside Hyprland Lua.
local action=arg[1]
local expr,query
if action=="--get" then expr='return require("hypr.controls").brightness_raw()';query=true
elseif action=="--get-level" or action=="--get-ui-level" then expr='return require("hypr.controls").brightness_get()';query=true
elseif action=="--inc" then expr='require("hypr.controls").brightness_step(2)'
elseif action=="--dec" then expr='require("hypr.controls").brightness_step(-2)'
elseif action=="--restore" then expr='require("hypr.controls").restore()'
elseif action=="--set-level" or action=="--set-ui-level" then
 local n=assert(tonumber(arg[2]),"Invalid brightness");assert(n==math.floor(n));expr='require("hypr.controls").brightness_set(' .. n .. ')'
else error("Unknown brightness command") end
local function quote(s)return "'" .. s:gsub("'","'\\''") .. "'" end
local cmd="hyprctl " .. (os.getenv("HYPRLAND_INSTANCE_SIGNATURE") and "" or "-i 0 ") .. (query and "repl " or "eval ") .. quote(expr)
local p=assert(io.popen(cmd));local s=p:read("*a");local ok=p:close()
if not ok then io.stderr:write(s);os.exit(1) end
if query then io.write(s) end
